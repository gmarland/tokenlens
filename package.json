  "devDependencies": {
    "@tokenlens/cli": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "turbo": "2.10.12",
    "typescript": "5.9.2",
    "vitest": "2.1.9"
  }
}
